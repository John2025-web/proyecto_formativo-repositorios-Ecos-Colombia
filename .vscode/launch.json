{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ApiPrueba (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend-visual/bin/Debug/net10.0/ApiPrueba.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend-visual",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "JWT_SECRET_KEY": "EcosColombia2025SecretKeyDefaultDevelopmentFallbackKey12345"
      }
    }
  ]
}
