{
  "info": {
    "_postman_id": "ecos-colombia-api-v1",
    "name": "Ecos Colombia API - Pruebas Oficiales (Swagger & Azure SQL)",
    "description": "Colección completa de pruebas de API para el proyecto formativo Ecos Colombia. Incluye autenticación JWT, manejo de cookies, pruebas CRUD para Usuarios, Reseñas, Cultura, Lugares Turísticos, Regiones, Gastronomía y Administradores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7119",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testLugarId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "testRecenaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Autenticacion (Auth)",
      "item": [
        {
          "name": "Login - Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token JWT capturado y guardado en variable collection: ' + jsonData.token.substring(0, 15) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"contraseña\": \"admin123\",\n  \"rol\": \"Administrador\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Auth/Login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Auth", "Login"]
            },
            "description": "Inicia sesión como Administrador. La API genera la cookie 'access_token' y devuelve el token JWT en el cuerpo JSON."
          }
        },
        {
          "name": "Login - Usuario Turista",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"juan.perez@ecoscolombia.com\",\n  \"contraseña\": \"Turista2026*\",\n  \"rol\": \"Usuario\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Auth/Login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "Auth", "Login"]
            }
          }
        },
